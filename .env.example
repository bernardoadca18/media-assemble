# ===========================================
# Configurações do Banco de Dados
# ===========================================
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5433/faceless_pipeline

# Docker Compose usa estas variáveis para o container PostgreSQL
POSTGRES_USER=faceless
POSTGRES_PASSWORD=faceless_secret
POSTGRES_DB=faceless_pipeline
POSTGRES_PORT=5433

# ===========================================
# LiteLLM / Modelos de Linguagem
# ===========================================
# Proxy LiteLLM centralizado (todas as requisições LLM passam por aqui)
# Liste modelos disponíveis: curl -s http://localhost:4000/v1/models
LITELLM_MASTER_KEY=sk-sua-chave-aqui
LITELLM_BASE_URL=http://host.docker.internal:4000

# Modelo local via LiteLLM proxy
LOCAL_MODEL_NAME=qwen-local
LOCAL_MODEL_BASE_URL=http://host.docker.internal:4000

# Modelos em nuvem via LiteLLM proxy (para tarefas que exigem mais qualidade)
CLOUD_MODEL_IDEACAO=gemini-3.6-flash
CLOUD_MODEL_ROTEIRO=gemini-3.1-pro

# ===========================================
# Áudio / GPU
# ===========================================
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Referência para F5-TTS (clone de voz)
F5_TTS_REF_AUDIO=data/voz_referencia/audio_ref.wav
F5_TTS_REF_TEXT="Texto de referência para clonagem de voz"

# ===========================================
# Pipeline
# ===========================================
# Nichos ativos (separados por vírgula)
# Nichos disponíveis: cultura_pop, tecnologia, futebol, financas, ciencia, historia
NICHOS_ATIVOS=cultura_pop

# Limite de WER (Word Error Rate) para aprovação do áudio
WER_LIMITE_APROVACAO=0.05

# Máximo de tentativas de TTS por cena
MAX_TENTATIVAS_TTS=3

# ===========================================
# Assets Externos
# ===========================================
# Chave de API do Pexels (para busca de imagens/vídeos licenciados)
PEXELS_API_KEY=

# Chave de API do YouTube Data API v3 (para vídeos em tendência)
# Obter em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ===========================================
# Frontend
# ===========================================
# URL da API backend (usada pelo frontend para fazer requisições)
VITE_API_URL=http://127.0.0.1:8080
