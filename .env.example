# ===========================================
# Configurações do Banco de Dados
# ===========================================
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/faceless_pipeline

# ===========================================
# LiteLLM / Modelos de Linguagem
# ===========================================
# URL do proxy LiteLLM (opcional, se estiver usando proxy)
LITELLM_PROXY_URL=

# Modelo local via Ollama/vLLM (para tarefas leves como normalização)
LOCAL_MODEL_NAME=ollama/qwen2.5:7b
LOCAL_MODEL_BASE_URL=http://localhost:11434

# Modelos em nuvem (para tarefas que exigem mais qualidade)
CLOUD_MODEL_IDEACAO=gemini/gemini-1.5-flash
CLOUD_MODEL_ROTEIRO=anthropic/claude-3-5-sonnet-20240620

# Chaves de API (configurar conforme o provedor usado)
# GEMINI_API_KEY=sua_chave_aqui
# OPENAI_API_KEY=sua_chave_aqui
# ANTHROPIC_API_KEY=sua_chave_aqui

# ===========================================
# Áudio / GPU
# ===========================================
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Referência para F5-TTS (clone de voz)
F5_TTS_REF_AUDIO=data/voz_referencia/minha_voz.wav
F5_TTS_REF_TEXT=

# ===========================================
# Pipeline
# ===========================================
# Nichos ativos (separados por vírgula)
# Nichos disponíveis: cultura_pop, tecnologia, futebol, financas, ciencia, historia
NICHOS_ATIVOS=cultura_pop

# Limite de WER (Word Error Rate) para aprovação do áudio
WER_LIMITE_APROVACAO=0.05

# Máximo de tentativas de TTS por cena
MAX_TENTATIVAS_TTS=3

# ===========================================
# Assets Externos
# ===========================================
# Chave de API do Pexels (para busca de imagens/vídeos licenciados)
PEXELS_API_KEY=

# ===========================================
# Fontes de Tendências
# ===========================================
# Chave de API do YouTube Data API v3 (para vídeos em tendência)
# Obter em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
